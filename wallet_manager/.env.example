# =============================================================================
# Wallet Manager — Environment Variables Example
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Fernet key for private key encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat / channel ID (your user ID or group ID)
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# RPC Endpoints (at least one required)
# ---------------------------------------------------------------------------

# Infura Base RPC
INFURA_KEY=
# BASE_RPC_1=https://base-mainnet.infura.io/v3/${INFURA_KEY}

# Alchemy Base RPC
ALCHEMY_KEY=
# BASE_RPC_2=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}

# Public Base RPC (fallback)
BASE_RPC_1=https://mainnet.base.org
BASE_RPC_2=https://base.drpc.org
BASE_RPC_3=

# Private RPC endpoints (optional, for MEV protection)
PRIVATE_RPC_1=
PRIVATE_RPC_2=
PRIVATE_RPC_3=

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------

# One of: legacy, quantx, ml_quant, robust_paper, robust, robust_live
EXECUTION_MODE=robust_paper

# ---------------------------------------------------------------------------
# Portfolio Allocation Weights (must sum to 1.0)
# ---------------------------------------------------------------------------

YIELD_WEIGHT=0.40
ALGO_WEIGHT=0.35
SHORT_WEIGHT=0.10
AIRDROP_WEIGHT=0.15
MONTHLY_INJECTION_USD=150.0
REBALANCE_DRIFT_THRESHOLD=0.05

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
# text or json (json for Grafana Loki / Elasticsearch)
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Metrics (Prometheus)
# ---------------------------------------------------------------------------

METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Telegram rate limiting
# ---------------------------------------------------------------------------

TELEGRAM_RATE_LIMIT=1.0
TELEGRAM_RATE_BURST=1

# ---------------------------------------------------------------------------
# Trade Journal
# ---------------------------------------------------------------------------

TRADE_JOURNAL_PATH=trade_journal.jsonl
TRADE_JOURNAL_MAX_MB=100.0

# ---------------------------------------------------------------------------
# Paper Trading
# ---------------------------------------------------------------------------

PAPER_TRADE=false
PAPER_INITIAL_BALANCE_USD=140.0

# ---------------------------------------------------------------------------
# Advanced (usually leave as defaults)
# ---------------------------------------------------------------------------

# RETRY_ATTEMPTS=4
# RETRY_BASE_DELAY=1.5
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_RECOVERY_TIMEOUT=30.0
# MAX_CONCURRENT_WALLETS=5
# GAS_POLL_INTERVAL=30.0
# LOOP_INTERVAL_SECONDS=45.0
# ALGO_LOOP_INTERVAL_SECONDS=300.0
# KELLY_FRACTION=0.25
# ML_CONFIDENCE_THRESHOLD=0.65
